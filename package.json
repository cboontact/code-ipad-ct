{
  "name": "chomthong-teacher-ipad-survey",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "node scripts/prepare-sites-migrations.mjs && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/sanitize-build.mjs",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log node scripts/start-worker-preview.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:load": "node scripts/load-test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./migrations/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./migrations/seed.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@riz007/thai-address-data": "^0.1.4",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "^9.3.10",
    "sonner": "^2.0.8",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
