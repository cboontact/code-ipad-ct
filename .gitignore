# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.dev.vars.example
.dev.vars

# local Cloudflare configuration (may contain production resource identifiers)
/wrangler.jsonc

# local databases, imports, exports, and backups
*.db
*.db-*
*.sqlite
*.sqlite3
*.dump
*.bak
*.csv
*.tsv
*.xls
*.xlsx
/uploads/
/imports/
/exports/
/backups/
/private-data/

# vercel
.vercel

# local OpenAI Sites project metadata
/.openai/

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
*.tsbuildinfo
